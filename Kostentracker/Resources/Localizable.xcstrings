        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ви отримуєте сповіщення про прострочені витрати, поки вони не оплачені"
          }
        }
      }
    },
    "You get notified about overdue expenses once" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
