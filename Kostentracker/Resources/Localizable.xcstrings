          }
        }
      }
    },
    "You receive one notification per expense based on your schedule" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erhältst eine Benachrichtigung pro Ausgabe basierend auf deiner Auswahl"
          }
        }
      }
    },
    "You receive one single notification sumarizing the amount of due and overdue expenses based on your schedule" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erhältst genau eine zusammenfassende Benachrichtigung zu überfälligen Ausgaben basierend auf deiner Auswahl"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Recibes una sola notificación que resume el monto de los gastos vencidos y por vencer según tu programación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous recevez une seule notification résumant le montant des dépenses dues et en retard selon votre planning"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi un'unica notifica che riepiloga l'importo delle spese in scadenza e scadute in base alla tua pianificazione"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
